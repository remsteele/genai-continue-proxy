# Required: OpenAI-compatible upstream endpoint. Do not include /chat/completions.
UPSTREAM_BASE_URL=https://your-upstream.example/v1

# Required: credential sent to the upstream as a Bearer token.
UPSTREAM_API_KEY=replace-with-your-upstream-api-key

# Required: value forwarded as `reasoning_effort` on every request.
REASONING_EFFORT=medium

# Optional: HTTP(S) proxy for outbound requests. Leave blank to connect directly.
OUTBOUND_PROXY_URL=
